---
// Sección Security & trust: los 4 compromisos. La gobernanza es sobre los
// usuarios de la institución (quién accede y qué puede hacer), no sobre los agentes.
const items = [
  {
    t: "Governance stays with the institution",
    d: "Each institution defines what its users can access and do. Control over every action stays on your side.",
    icon: "M12 3l8 4v5c0 4-3.2 7.4-8 9-4.8-1.6-8-5-8-9V7l8-4zM9 12l2 2 4-4",
  },
  {
    t: "Human in the loop by design",
    d: "The agent proposes, the person approves. Autonomy is earned with use — it is never assumed.",
    icon: "M12 12a4 4 0 100-8 4 4 0 000 8zM4.5 20.5a7.5 7.5 0 0115 0M16.5 12.5l2 2 3.5-3.5",
  },
  {
    t: "Roles and permissions",
    d: "Granular down to the level each institution needs, with a complete audit trail of every action.",
    icon: "M7 3h7l5 5v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1zM14 3v5h5M9 14l2 2 4-4",
  },
  {
    t: "Integrations built with you",
    d: "We work closely with each institution on the integrations it needs — faithful to the source, and in both directions.",
    icon: "M8.5 7.5h-2a5 5 0 000 10h2M15.5 7.5h2a5 5 0 010 10h-2M8 12.5h8",
  },
];
---

<div class="sec">
  {
    items.map((i) => (
      <div class="sec-item">
        <span class="sec-ic">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={i.icon} />
          </svg>
        </span>
        <div class="sec-body">
          <h3>{i.t}</h3>
          <p>{i.d}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .sec {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px 32px;
    margin-top: 36px;
  }
  .sec-item {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 14px;
    align-items: start;
  }
  .sec-ic {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .sec-body h3 {
    margin: 3px 0 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .sec-body p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  @media only screen and (max-width: 1024px) {
    .sec { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
