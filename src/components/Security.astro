---
// Sección Security & trust: los 4 compromisos de confidencialidad.
// Copy del sitio actual + el ajuste del Notion ("highest" en vez de "strictest").
const items = [
  {
    t: "PHI is never shared with LLMs",
    d: "Protected health information and personal data are never sent to LLM providers — identifiers are stripped before any model call.",
    icon: "M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z",
  },
  {
    t: "No training on your data",
    d: "Patient data is never used to train models. Your information stays yours.",
    icon: "M6 4h9l4 4v12a1 1 0 01-1 1H6a1 1 0 01-1-1V5a1 1 0 011-1zM4 4l16 16",
  },
  {
    t: "Works inside your stack",
    d: "Integrates with your HIS/EMR and PACS — and runs at the OS layer where direct integration isn't possible.",
    icon: "M4 6h16M4 12h16M4 18h10M18 15v6M15 18h6",
  },
  {
    t: "Governance by design",
    d: "Human-in-the-loop controls, audit trails, and role-based access across every workflow.",
    icon: "M12 3l8 4v5c0 4-3.2 7.4-8 9-4.8-1.6-8-5-8-9V7l8-4zM9 12l2 2 4-4",
  },
];
---

<div class="sec">
  {
    items.map((i) => (
      <div class="sec-item">
        <span class="sec-ic">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={i.icon} />
          </svg>
        </span>
        <div class="sec-body">
          <h3>{i.t}</h3>
          <p>{i.d}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .sec {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px 32px;
    margin-top: 36px;
  }
  .sec-item {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 14px;
    align-items: start;
  }
  .sec-ic {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .sec-body h3 {
    margin: 3px 0 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .sec-body p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  @media only screen and (max-width: 1024px) {
    .sec { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
