---
// Sección de contenido del deck. Alineada a la izquierda (misma x que el hero),
// por delante del glass fijo. Entra con deblur→nítido cuando la sección se activa.
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  paragraphs?: string[];
  /** statement centrado (WÚRU, Vision) */
  center?: boolean;
  /** contenido a dos columnas: título a la izquierda, contenido a la derecha */
  split?: boolean;
  /** fondo full-bleed propio para toda la sección, con parallax (va por detrás) */
  panel?: boolean;
  /** viewports extra de scroll con el contenido pineado (permanece más tiempo) */
  dwell?: number;
}
const {
  id,
  eyebrow,
  title,
  paragraphs = [],
  center = false,
  split = false,
  panel = false,
  dwell = 0,
} = Astro.props;
---

<section
  class:list={[
    "deck-section",
    { "snap-section": !dwell },
    { "is-center": center, "is-split": split, "has-panel": panel, "has-dwell": !!dwell },
  ]}
  id={id}
  style={dwell ? `--dwell: ${dwell}` : undefined}
>
  {
    panel && (
      <div class="ds-fill" aria-hidden="true">
        <div class="ds-fill-dots" />
        <div class="ds-fill-inner" />
      </div>
    )
  }
  <div class="ds-stage">
  {
    Astro.slots.has("bg") && (
      <div class="ds-bg">
        <slot name="bg" />
      </div>
    )
  }
  <div class="ds-inner">
    <div class="ds-head">
      {Astro.slots.has("mark") && (
        <div class="ds-mark">
          <slot name="mark" />
        </div>
      )}
      {eyebrow && <span class="ds-eyebrow">{eyebrow}</span>}
      <h2 class="ds-title" set:html={title} />
      {paragraphs.map((p) => <p class="ds-body" set:html={p} />)}
    </div>
    {
      Astro.slots.has("default") && (
        <div class="ds-content">
          <slot />
        </div>
      )
    }
  </div>
  </div>
  {
    Astro.slots.has("aside") && (
      <div class="ds-aside">
        <slot name="aside" />
      </div>
    )
  }
</section>

<script>
  // Parallax del fondo de sección: se mueve más lento que la página, así la
  // sección parece pasar por delante. Corre una vez para todas las instancias.
  import { animate, scroll } from "motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && !document.documentElement.dataset.dsParallax) {
    document.documentElement.dataset.dsParallax = "1";
    document.querySelectorAll<HTMLElement>(".ds-fill").forEach((fill) => {
      const inner = fill.querySelector<HTMLElement>(".ds-fill-inner");
      const section = fill.closest<HTMLElement>(".deck-section");
      if (!inner || !section) return;
      scroll(animate(inner, { y: [-110, 110] }, { ease: "linear" }), {
        target: section,
        offset: ["start end", "end start"],
      });
    });
  }
</script>

<style lang="scss">
  .deck-section {
    position: relative;
    z-index: 30; /* por delante del glass fijo (z20) */
    isolation: isolate;
    min-height: 100vh;
    padding-left: calc(var(--gutter) + 48px);
    padding-right: var(--gutter);
  }

  /* stage: es el que centra el contenido. Con dwell se pinea, así la sección
     permanece más tiempo en pantalla en vez de pasar de largo. */
  .ds-stage {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 100vh;
  }
  .has-dwell {
    min-height: 0;
    height: calc((1 + var(--dwell, 1)) * 100vh);
    scroll-snap-align: start;
  }
  .has-dwell .ds-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 0;
  }

  /* Fondo full-bleed de la sección (mismo rol que la imagen del hero): ocupa
     toda la sección y se mueve más lento que el scroll, así parece ir por
     detrás. La capa interna está sobredimensionada para tener recorrido. */
  /* la sección con fondo propio SE MONTA sobre la anterior: arranca antes de que
     la anterior termine, con esquinas superiores redondeadas y sombra hacia
     arriba, así al scrollear parece trepar por encima. */
  .has-panel {
    /* plano pleno de borde a borde: SIN radius (no es una card).
       El "monte" lo da el margen negativo + la sombra hacia arriba. */
    margin-top: clamp(-14vh, -10vh, -60px);
    z-index: 31;
    box-shadow: 0 -26px 60px -22px rgba(0, 0, 0, 0.42);
  }
  /* si hay dos con fondo seguidas, la de abajo monta sobre la de arriba */
  .has-panel + .has-panel {
    z-index: 32;
  }

  .ds-fill {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* fondo PLENO (opaco): la sección es su propio plano */
    background: var(--section-fill, var(--section-bg));
  }
  /* dots de la sección: capa aparte, quietas (sin parallax ni deriva),
     igual que las del fondo de la página (en temas sin dots quedan invisibles) */
  .ds-fill-dots {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(26vw 26vw at 12% 18%, var(--dot-a, transparent), transparent 64%),
      radial-gradient(21vw 21vw at 84% 30%, var(--dot-b, transparent), transparent 64%),
      radial-gradient(24vw 24vw at 32% 88%, var(--dot-c, transparent), transparent 64%),
      radial-gradient(16vw 16vw at 68% 72%, var(--dot-b, transparent), transparent 64%);
  }

  .ds-fill-inner {
    position: absolute;
    top: -18%;
    left: 0;
    width: 100%;
    height: 136%;
    /* textura sutil encima del pleno, es lo que se mueve con el parallax */
    background:
      radial-gradient(
        80% 60% at 16% 14%,
        color-mix(in srgb, var(--accent) 13%, transparent),
        transparent 60%
      ),
      radial-gradient(
        70% 55% at 88% 86%,
        color-mix(in srgb, var(--fg) 7%, transparent),
        transparent 60%
      );
    will-change: transform;
  }

  /* fondo full-bleed de la sección (detrás del contenido).
     Sin overflow:hidden → el gráfico grande no se corta; el sobrante queda
     fuera de pantalla cuando la sección está encuadrada (snap). */
  .ds-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: grid;
    place-items: center; /* centra el gráfico de fondo (ej. las 4 layers) */
  }

  .ds-inner {
    position: relative;
    z-index: 1; /* contenido por delante del fondo */
    max-width: 760px;
    /* base: desenfocado/oculto. Salida (al desactivarse): rápida, sin delay */
    filter: blur(18px);
    opacity: 0;
    transform: translateY(18px);
    transition:
      filter 0.4s ease,
      opacity 0.4s ease,
      transform 0.4s ease;
    will-change: filter, opacity, transform;
  }

  /* entrada (al activarse): con delay para que el glass expanda primero */
  .deck-section.is-active .ds-inner {
    filter: blur(0);
    opacity: 1;
    transform: none;
    transition:
      filter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s,
      opacity 0.8s ease 0.45s,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s;
  }

  .ds-eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .ds-title {
    margin: 0 0 24px;
    font-size: clamp(32px, 4.4vw, 56px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  /* palabra resaltada dentro del título (viene por set:html) */
  .ds-title :global(.hl) {
    color: var(--accent);
  }

  .ds-body {
    margin: 0 0 16px;
    max-width: 640px;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.65;
    color: var(--fg-muted);
  }
  /* énfasis dentro del body (viene por set:html) */
  .ds-body :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  /* ── Variante a dos columnas: título a la izquierda, contenido a la derecha ── */
  .is-split .ds-inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) 1.35fr;
    gap: clamp(30px, 4.5vw, 68px);
    align-items: start;
    max-width: 1180px;
  }
  .is-split .ds-title {
    font-size: clamp(28px, 3.1vw, 42px);
    margin-bottom: 18px;
  }
  .is-split .ds-body {
    font-size: clamp(14px, 1.1vw, 16.5px);
    max-width: 42ch;
  }
  /* en split el contenido ya está en su columna: sin margen superior propio */
  .is-split .ds-content > :global(*) {
    margin-top: 0;
  }
  /* el panel entra un poco más adentro cuando la sección tiene panel */
  .has-panel .ds-inner {
    padding: clamp(28px, 4vh, 56px) 0;
  }

  /* Variante centrada + más brutalista (ej. statement de WÚRU, sin gráfico) */
  .deck-section.is-center {
    text-align: center;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
  .is-center .ds-stage {
    justify-content: center;
  }
  .is-center .ds-inner {
    max-width: 960px;
    margin-inline: auto;
    /* el statement no desenfoca en bloque: cada línea entra/sale sola */
    filter: none;
    opacity: 1;
    transform: none;
    transition: none;
  }
  .is-center .ds-eyebrow {
    letter-spacing: 3px;
  }
  .ds-mark {
    margin-bottom: 30px;
  }
  .is-center .ds-mark {
    display: flex;
    justify-content: center;
  }
  .is-center .ds-title {
    max-width: min(90vw, 820px);
    margin: 0 auto 22px;
    font-size: clamp(40px, 6.5vw, 86px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  /* título en varias líneas con jerarquía (viene por set:html) */
  .ds-title :global(.t-the) {
    display: block;
    text-align: left;
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg-muted);
    line-height: 1.2;
  }
  .ds-title :global(.t-hero) {
    display: block;
    white-space: nowrap;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.94;
    margin: 0.02em 0 0.06em;
  }
  .ds-title :global(.t-sub) {
    display: block;
    font-size: 0.64em;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--fg-muted);
    line-height: 1.1;
  }
  .is-center .ds-body {
    margin: 0 auto;
    max-width: none;
    white-space: nowrap; /* subtexto en una sola línea */
    font-size: clamp(16px, 1.4vw, 20px);
  }

  /* WÚRU: animación por línea (in/out), escalonada — no en bloque */
  .is-center .ds-mark,
  .is-center .ds-title :global(.t-the),
  .is-center .ds-title :global(.t-hero),
  .is-center .ds-title :global(.t-sub),
  .is-center .ds-body {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .is-center .ds-mark { transition-delay: 0.02s; }
  .is-center .ds-title :global(.t-the) { transition-delay: 0.14s; }
  .is-center .ds-title :global(.t-hero) { transition-delay: 0.24s; }
  .is-center .ds-title :global(.t-sub) { transition-delay: 0.36s; }
  .is-center .ds-body { transition-delay: 0.48s; }
  .is-center.is-active .ds-mark,
  .is-center.is-active .ds-title :global(.t-the),
  .is-center.is-active .ds-title :global(.t-hero),
  .is-center.is-active .ds-title :global(.t-sub),
  .is-center.is-active .ds-body {
    opacity: 1;
    transform: none;
  }

  /* región decorativa a la derecha (gráfico isométrico, etc.) */
  .ds-aside {
    position: absolute;
    right: clamp(140px, 15vw, 440px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    pointer-events: none;
    /* el container solo hace fade (las capas se apilan solas al activarse) */
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .deck-section.is-active .ds-aside {
    opacity: 1;
    transition: opacity 0.6s ease 0.15s;
  }

  @media only screen and (max-width: 1200px) {
    .ds-aside {
      display: none; /* decorativo: se oculta en pantallas chicas */
    }
  }

  @media only screen and (max-width: 1024px) {
    .deck-section {
      padding-left: 24px;
      padding-right: 24px;
    }
    /* en pantallas chicas el split se apila */
    .is-split .ds-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .is-split .ds-content > :global(*) {
      margin-top: 0;
    }
    .ds-inner {
      /* en mobile no dependemos del deblur por scroll */
      filter: none;
      opacity: 1;
      transform: none;
    }
    /* en pantallas chicas el subtexto puede envolver (evita overflow) */
    .is-center .ds-body {
      white-space: normal;
    }
    /* mobile: mostrar las líneas del statement sin depender del scroll */
    .is-center .ds-mark,
    .is-center .ds-title :global(.t-the),
    .is-center .ds-title :global(.t-hero),
    .is-center .ds-title :global(.t-sub),
    .is-center .ds-body {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-center .ds-mark,
    .is-center .ds-title :global(.t-the),
    .is-center .ds-title :global(.t-hero),
    .is-center .ds-title :global(.t-sub),
    .is-center .ds-body {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
