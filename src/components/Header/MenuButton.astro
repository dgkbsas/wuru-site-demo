---
// Menú hamburguesa (derecha del header). Reúne el acceso a la app, el onboarding,
// las redes y lo que antes vivía en el footer flotante: contacto, docs, privacy
// y el copyright.
import { Image } from "astro:assets";
import LogoLN from "../../assets/images/svg-ln.svg";
import LogoIG from "../../assets/images/svg-ig.svg";
import UserCircle from "../../assets/images/user-circle.svg";
---

<div class="menu">
  <button
    class="menu-btn"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <div class="menu-scrim" hidden></div>

  <nav class="menu-panel" id="site-menu" hidden aria-label="Site menu">
    <a class="menu-app" href="http://app.wuru.ai" target="_blank" title="Log in" rel="noopener noreferrer">
      <span class="app-t">LOG IN</span>
      <Image src={UserCircle} alt="" height={26} class="app-ic" loading="eager" />
    </a>

    <ul class="menu-links">
      <li><a href="/signup">Onboarding</a></li>
      <li><a href="http://docs.wuru.ai" target="_blank" rel="noopener noreferrer">Docs</a></li>
      <li><a href="/privacy-policy">Privacy</a></li>
    </ul>

    <!-- no es una página: abre el cliente de mail -->
    <a class="menu-mail" href="mailto:hola@wuru.ai">
      <span class="mail-ic">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
          <path d="M3 6l9 6.5L21 6" />
        </svg>
      </span>
      <span class="mail-txt">
        <span class="mail-t">hola@wuru.ai</span>
        <span class="mail-s">Write to us</span>
      </span>
    </a>

    <div class="menu-foot">
      <span class="menu-social">
        <a href="https://www.linkedin.com/company/wuru/" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn">
          <Image src={LogoLN} alt="" height={16} class="soc-ic" loading="eager" />
        </a>
        <a href="http://www.instagram.com/somoswuru" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram">
          <Image src={LogoIG} alt="" height={17} class="soc-ic" loading="eager" />
        </a>
      </span>
      <span class="menu-copy">© 2026 Wúru</span>
    </div>
  </nav>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>(".menu");
  if (wrap) {
    const btn = wrap.querySelector<HTMLButtonElement>(".menu-btn");
    const panel = wrap.querySelector<HTMLElement>(".menu-panel");
    const scrim = wrap.querySelector<HTMLElement>(".menu-scrim");
    let open = false;

    const setOpen = (v: boolean) => {
      open = v;
      wrap.classList.toggle("is-open", v);
      btn?.setAttribute("aria-expanded", String(v));
      // hidden se saca antes de animar y se repone después de cerrar
      if (v) {
        panel?.removeAttribute("hidden");
        scrim?.removeAttribute("hidden");
      } else {
        setTimeout(() => {
          if (!open) {
            panel?.setAttribute("hidden", "");
            scrim?.setAttribute("hidden", "");
          }
        }, 260);
      }
    };

    btn?.addEventListener("click", () => setOpen(!open));
    scrim?.addEventListener("click", () => setOpen(false));
    // cerrar al elegir un destino o con Escape
    panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) setOpen(false);
    });
  }
</script>

<style lang="scss">
  .menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* botón: dos barras que se cruzan al abrir */
  .menu-btn {
    position: relative;
    z-index: 2;
    width: 48px;
    height: 48px;
    display: grid;
    place-content: center;
    gap: 5px;
    padding: 0;
    border: 1px solid var(--btn-ghost-border);
    border-radius: 100px;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;

    &:hover {
      background: color-mix(in srgb, var(--fg) 7%, transparent);
    }
  }
  .bar {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--fg);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
  }
  .is-open .menu-btn {
    border-color: color-mix(in srgb, var(--fg) 45%, transparent);
  }
  .is-open .bar:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }
  .is-open .bar:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* velo para cerrar tocando afuera */
  .menu-scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.28);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .is-open .menu-scrim {
    opacity: 1;
  }

  /* panel */
  .menu-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    z-index: 2;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--section-bg) 92%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 26px 60px -24px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.24s ease,
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-panel[hidden] {
    display: none;
  }
  .is-open .menu-panel {
    opacity: 1;
    transform: none;
  }

  /* acceso a la app: mismo lenguaje que el botón LOG IN original (pill + icono
     de usuario), y con alto de target cómodo para touch */
  .menu-app {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding: 0 14px 0 20px;
    border-radius: 100px;
    text-decoration: none;
    color: var(--fg);
    border: 1px solid var(--btn-ghost-border);
    background: transparent;
    transition: background 0.25s ease, border-color 0.25s ease;

    &:hover,
    &:active {
      background: color-mix(in srgb, var(--fg) 8%, transparent);
      border-color: color-mix(in srgb, var(--fg) 45%, transparent);
    }
  }
  .app-t {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
  }
  .app-ic {
    width: auto;
    flex-shrink: 0;
    filter: var(--icon-filter, brightness(0) invert(1));
  }

  /* enlaces (lo que vivía en el footer) */
  .menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .menu-links a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    transition: background 0.2s ease;

    &:hover,
    &:active {
      background: color-mix(in srgb, var(--fg) 8%, transparent);
    }
  }

  /* el mail no es un destino de navegación: se distingue de la lista */
  .menu-mail {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 50px;
    padding: 0 14px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg) 11%, transparent);
    transition: background 0.2s ease;

    &:hover,
    &:active {
      background: color-mix(in srgb, var(--fg) 10%, transparent);
    }
  }
  .mail-ic {
    display: grid;
    place-items: center;
    color: var(--accent);
    flex-shrink: 0;
  }
  .mail-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .mail-t {
    font-size: 14px;
    font-weight: 600;
  }
  .mail-s {
    font-size: 11.5px;
    color: var(--fg-muted);
  }

  .menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
  }
  .menu-copy {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--fg-muted);
  }
  /* redes: iconos monocromos, con el filtro del tema */
  .menu-social {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .menu-social a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -10px;
    opacity: 0.6;
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 1;
    }
  }
  .soc-ic {
    filter: var(--icon-filter, brightness(0) invert(1));
    width: auto;
  }

  @media only screen and (max-width: 480px) {
    .menu-panel {
      width: min(280px, calc(100vw - 40px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .menu-panel,
    .menu-scrim,
    .app-go {
      transition: none;
    }
  }
</style>
