---
import { Image } from "astro:assets";
import WuruLogo from "../../assets/images/wuru-logo.svg";
import UserCircle from "../../assets/images/user-circle.svg";
import SocialMediaNav from "./SocialMediaNav.astro";
---

<header class="header-container">
  <div class="left-side">
    <a id="wuru-logo" href="/" title="Go to WÚRU home" rel="noopener noreferrer">
      <Image src={WuruLogo} alt="wuru-logo" height={32} class="wuru-logo" loading={"eager"} />
    </a>
  </div>
  <div class="right-side">
    <SocialMediaNav />
    <a class="log-in-btn" href="http://app.wuru.ai" target="_blank" title="Log in" rel="noopener noreferrer">
      <span class="text">LOG IN</span>
      <Image src={UserCircle} alt="login-icon" height={28} class="login-icon" loading={"eager"} />
    </a>
  </div>
</header>

<style lang="scss">
  @keyframes logo-in-slide {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes login-appears {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    color: var(--fg);
    padding: 24px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    .left-side {
      display: flex;
      align-items: baseline;
      gap: 32px;

      a {
        text-decoration: none;
        color: unset;
      }
      .typo-nav {
        display: flex;
        gap: 24px;
      }
      .icon-nav {
        display: none;
        align-items: center;
        gap: 24px;
        justify-content: center;
        opacity: 0.7;
      }
      .nav-link {
        font-size: 14px;
        transition: all 0.2s ease-in-out;
        letter-spacing: 1px;
        opacity: 0;
        animation: login-appears 0.2s ease-out forwards;
        animation-delay: 0.25s;

        &:hover {
          color: #f1f1f1b0;
        }
      }
      .wuru-logo {
        animation: logo-in-slide 0.8s ease-out forwards;
      }
    }
    .right-side {
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 64px;
      .log-in-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--fg);
        background: transparent;
        border: 1px solid var(--btn-ghost-border);
        padding: 11px 26px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 100px;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        opacity: 0;
        animation: login-appears 0.2s ease-out forwards;
        animation-delay: 0.8s;

        &:hover {
          border-color: var(--fg);
          background: rgba(127, 127, 127, 0.1);
        }
      }
      .login-icon {
        display: none;
        filter: var(--icon-filter, none);
      }
    }
  }

  @media only screen and (max-width: 1024px) {
    .header-container {
      padding: 12px 24px !important;

      .left-side {
        align-items: center;
        #wuru-logo {
          width: 120px !important;
        }
        gap: 40px;
        .typo-nav {
          display: none;
        }
        .icon-nav {
          display: flex;
          gap: 40px;
        }
      }
    }
  }

  @media only screen and (max-width: 768px) {
    .header-container {
      .right-side {
        .log-in-btn {
          padding: 12px !important;
          height: 48px;
          width: 48px;
          border-radius: 24px;
          display: flex;
          align-items: center;
          justify-content: center;
          .login-icon {
            display: block;
            opacity: 0.7 !important;
          }
          .text {
            display: none !important;
          }
        }
      }
    }
  }
</style>
