---
import { Image } from "astro:assets";
import WuruLogo from "../../assets/images/wuru-logo.svg";
import UserCircle from "../../assets/images/user-circle.svg";
import SocialMediaNav from "./SocialMediaNav.astro";
import MenuButton from "./MenuButton.astro";
---

<script>
  // el velo del header aparece recién al scrollear (en el hero no hace falta)
  const header = document.querySelector<HTMLElement>(".header-container");
  if (header) {
    const sync = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
    window.addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>

<header class="header-container">
  <div class="left-side">
    <a id="wuru-logo" href="/" title="Go to WÚRU home" rel="noopener noreferrer">
      <Image src={WuruLogo} alt="wuru-logo" height={32} class="wuru-logo" loading={"eager"} />
    </a>
  </div>
  <!-- en desktop: redes + LOG IN. En pantallas chicas: sólo el menú sándwich -->
  <div class="right-side">
    <div class="desktop-only">
      <SocialMediaNav />
      <a class="log-in-btn" href="http://app.wuru.ai" target="_blank" title="Log in" rel="noopener noreferrer">
        <span class="text">LOG IN</span>
        <Image src={UserCircle} alt="login-icon" height={28} class="login-icon" loading={"eager"} />
      </a>
    </div>
    <div class="mobile-only">
      <MenuButton />
    </div>
  </div>
</header>

<style lang="scss">
  @keyframes logo-in-slide {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes login-appears {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    color: var(--fg);
    padding: 24px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* el header queda fijo sobre el contenido: un velo desde arriba evita que
       el logo choque contra el texto de las secciones al scrollear */
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--section-bg) 82%, transparent) 0%,
        color-mix(in srgb, var(--section-bg) 55%, transparent) 55%,
        transparent 100%
      );
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    &.is-scrolled::before {
      opacity: 1;
    }
    .left-side {
      display: flex;
      align-items: baseline;
      gap: 32px;

      a {
        text-decoration: none;
        color: unset;
      }
      .typo-nav {
        display: flex;
        gap: 24px;
      }
      .icon-nav {
        display: none;
        align-items: center;
        gap: 24px;
        justify-content: center;
        opacity: 0.7;
      }
      .nav-link {
        font-size: 14px;
        transition: all 0.2s ease-in-out;
        letter-spacing: 1px;
        opacity: 0;
        animation: login-appears 0.2s ease-out forwards;
        animation-delay: 0.25s;

        &:hover {
          color: #f1f1f1b0;
        }
      }
      .wuru-logo {
        animation: logo-in-slide 0.8s ease-out forwards;
      }
    }
    .right-side {
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 64px;
      /* el sándwich es sólo para pantallas chicas */
      .desktop-only {
        display: flex;
        align-items: center;
        gap: 64px;
      }
      .mobile-only {
        display: none;
      }
      .log-in-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--fg);
        background: transparent;
        border: 1px solid var(--btn-ghost-border);
        padding: 11px 26px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 100px;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        opacity: 0;
        animation: login-appears 0.2s ease-out forwards;
        animation-delay: 0.8s;

        &:hover {
          border-color: var(--fg);
          background: rgba(127, 127, 127, 0.1);
        }
      }
      .login-icon {
        display: none;
        filter: var(--icon-filter, none);
      }
    }
  }

  @media only screen and (max-width: 1024px) {
    .header-container {
      padding: 12px 24px !important;

      .left-side {
        align-items: center;
        #wuru-logo {
          width: 120px !important;
        }
        gap: 40px;
        .typo-nav {
          display: none;
        }
        .icon-nav {
          display: flex;
          gap: 40px;
        }
      }
      /* acá se hace el cambio: redes + LOG IN salen, entra el sándwich */
      .right-side {
        .desktop-only {
          display: none;
        }
        .mobile-only {
          display: flex;
        }
      }
    }
  }
</style>
