---
// Switcher de temas. Guarda la elección en localStorage.
---

<div class="theme-switcher" role="group" aria-label="Change theme">
  <button class="theme-dot t-dark" data-theme-value="dark" title="Dark plum" aria-label="Dark plum theme"></button>
  <button class="theme-dot t-midnight" data-theme-value="midnight" title="Midnight" aria-label="Midnight theme"></button>
  <button class="theme-dot t-teal" data-theme-value="teal" title="Teal" aria-label="Teal theme"></button>
  <button class="theme-dot t-dawn" data-theme-value="dawn" title="Soft light" aria-label="Soft light theme"></button>
  <button class="theme-dot t-light" data-theme-value="light" title="Light pink" aria-label="Light pink theme"></button>
  <button class="theme-dot t-lighttr" data-theme-value="light-tr" title="Light" aria-label="Light theme"></button>
  <button class="theme-dot t-blush" data-theme-value="blush" title="Light magenta" aria-label="Light magenta theme"></button>
  <button class="theme-dot t-pastel" data-theme-value="pastel" title="Pastel white" aria-label="Pastel white theme"></button>
  <button class="theme-dot t-cream" data-theme-value="cream" title="Pastel cream" aria-label="Pastel cream theme"></button>
  <button class="theme-dot t-rose" data-theme-value="rose" title="Pastel rose" aria-label="Pastel rose theme"></button>
  <button class="theme-dot t-dots" data-theme-value="dots" title="Blurred dots" aria-label="Blurred dots theme"></button>
  <button class="theme-dot t-dots-teal" data-theme-value="dots-teal" title="Blurred dots · teal" aria-label="Blurred dots teal theme"></button>
  <button class="theme-dot t-dots-many" data-theme-value="dots-many" title="Many dots" aria-label="Many dots theme"></button>
  <span class="sw-divider"></span>
  <span class="glow-levels" role="group" aria-label="Magenta light brightness">
    <button class="glow-level lvl-off" data-glow-value="off" title="Light off" aria-label="Light off"></button>
    <button class="glow-level lvl1" data-glow-value="1" title="Soft light" aria-label="Soft light"></button>
    <button class="glow-level lvl2" data-glow-value="2" title="Medium light" aria-label="Medium light"></button>
    <button class="glow-level lvl3" data-glow-value="3" title="Strong light" aria-label="Strong light"></button>
  </span>
</div>

<script>
  const KEY = "wuru-theme";
  const root = document.documentElement;

  const saved = localStorage.getItem(KEY);
  if (saved) root.dataset.theme = saved;

  const sync = () => {
    const cur = root.dataset.theme || "dark";
    document.querySelectorAll<HTMLButtonElement>(".theme-dot").forEach((d) => {
      d.classList.toggle("active", d.getAttribute("data-theme-value") === cur);
    });
  };

  document.querySelectorAll<HTMLButtonElement>(".theme-dot").forEach((dot) => {
    dot.addEventListener("click", () => {
      const val = dot.getAttribute("data-theme-value");
      if (!val) return;
      root.dataset.theme = val;
      try {
        localStorage.setItem(KEY, val);
      } catch (e) {}
      sync();
    });
  });

  sync();

  // Luz magenta ambiental — OFF + 3 niveles de brillo
  const glowLevels = Array.from(document.querySelectorAll<HTMLButtonElement>(".glow-level"));
  const savedGlow = localStorage.getItem("wuru-glow");
  if (savedGlow === "1" || savedGlow === "2" || savedGlow === "3") root.dataset.glow = savedGlow;
  else if (savedGlow === "off") delete root.dataset.glow;
  const syncGlow = () => {
    const cur = root.dataset.glow || "off";
    glowLevels.forEach((b) => b.classList.toggle("active", b.dataset.glowValue === cur));
  };
  glowLevels.forEach((btn) => {
    btn.addEventListener("click", () => {
      const val = btn.dataset.glowValue;
      if (!val) return;
      if (val === "off") delete root.dataset.glow;
      else root.dataset.glow = val;
      try {
        localStorage.setItem("wuru-glow", val);
      } catch (e) {}
      syncGlow();
    });
  });
  syncGlow();

  // Los dots del fondo no dependen del scroll: derivan solos, en loop
  // (el movimiento vive en CSS — ver .page-dots en globals.scss).
</script>

<style>
  .theme-switcher {
    position: fixed;
    top: 26px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 100px;
    background: rgba(127, 127, 127, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(127, 127, 127, 0.22);
  }
  .theme-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    cursor: pointer;
    padding: 0;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .theme-dot:hover {
    transform: scale(1.18);
  }
  .theme-dot.active {
    box-shadow: 0 0 0 2px rgba(127, 127, 127, 0.55);
    transform: scale(1.1);
  }
  .t-dark {
    background: linear-gradient(135deg, #360124, #0e0e0e);
  }
  .t-midnight {
    background: linear-gradient(135deg, #1a1e46, #0a0a12);
  }
  .t-teal {
    background: linear-gradient(135deg, #0a3b34, #08110f);
  }
  .t-dawn {
    background: radial-gradient(circle at 28% 42%, #c8492f, #1a0d1e);
  }
  .t-light {
    background: linear-gradient(135deg, #f2d6e8, #d9c5f1);
  }
  .t-lighttr {
    background: linear-gradient(225deg, #3a2436 22%, #f6e6ee);
  }
  .t-blush {
    background: radial-gradient(circle at 32% 78%, #c62a5a, #ede9ed 78%);
  }
  .t-pastel {
    background: linear-gradient(135deg, #fdfcff, #f2ecf4);
  }
  .t-cream {
    background: linear-gradient(135deg, #fffdf6, #f2dfb8);
  }
  .t-rose {
    background: linear-gradient(135deg, #fffafc, #f4cdd9);
  }
  .t-dots {
    background: radial-gradient(circle at 30% 30%, #c62a5a 22%, transparent 26%),
      radial-gradient(circle at 70% 66%, #8246be 20%, transparent 24%), #ece7ee;
  }
  .t-dots-teal {
    background: radial-gradient(circle at 30% 32%, #1f8f78 22%, transparent 26%),
      radial-gradient(circle at 70% 66%, #46aac8 20%, transparent 24%), #e6efec;
  }
  .t-dots-many {
    background: radial-gradient(circle at 26% 26%, #7b4ad8 17%, transparent 21%),
      radial-gradient(circle at 70% 34%, #d6468c 15%, transparent 19%),
      radial-gradient(circle at 34% 72%, #50aadc 15%, transparent 19%),
      radial-gradient(circle at 74% 74%, #7b4ad8 13%, transparent 17%), #ece8ef;
  }
  .sw-divider {
    width: 1px;
    height: 16px;
    background: rgba(127, 127, 127, 0.3);
    margin: 0 2px;
  }
  .glow-levels {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .glow-level {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(214, 40, 120, 0.5);
    cursor: pointer;
    padding: 0;
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  /* apagado: círculo vacío con una barra diagonal */
  .glow-level.lvl-off {
    background: transparent;
    border-color: rgba(127, 127, 127, 0.55);
    position: relative;
    overflow: hidden;
  }
  .glow-level.lvl-off::after {
    content: "";
    position: absolute;
    left: -2px;
    right: -2px;
    top: 50%;
    height: 1px;
    background: rgba(127, 127, 127, 0.7);
    transform: rotate(-45deg);
  }
  .glow-level.lvl-off.active {
    background: transparent;
    border-color: var(--fg, #888);
    box-shadow: 0 0 0 2px rgba(127, 127, 127, 0.4);
  }
  .glow-level.lvl-off.active::after {
    background: var(--fg, #888);
  }
  .glow-level.lvl1 {
    background: rgba(214, 40, 120, 0.2);
  }
  .glow-level.lvl2 {
    background: rgba(214, 40, 120, 0.45);
  }
  .glow-level.lvl3 {
    background: rgba(214, 40, 120, 0.75);
  }
  .glow-level:hover {
    transform: scale(1.2);
  }
  .glow-level.active {
    background: radial-gradient(circle, #ff3ea0, #d62878);
    border-color: #ff3ea0;
    box-shadow: 0 0 8px rgba(214, 40, 120, 0.85);
  }
</style>
