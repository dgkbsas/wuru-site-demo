---
// Sección WÚRU — visión. Cita dominante con regla coral en degradé,
// wordmark gigante en outline (parallax) y revelado en secuencia.
---

<section class="deck wuru snap-section" id="wuru" data-animate>
  <span class="wuru-mark" data-parallax="-0.09" aria-hidden="true">wúru</span>

  <div class="wrap">
    <div class="wuru-content">
      <span class="eyebrow reveal">Nuestra visión</span>
      <blockquote class="wuru-quote reveal">
        El equipo clínico aporta <em>criterio</em>. La IA aporta <em>velocidad</em>. Juntos, más
        tiempo para los pacientes.
      </blockquote>
      <p class="wuru-lead reveal">
        Estamos construyendo la empresa más nativa de IA en salud — agentes embebidos en nuestros
        productos, y en nuestra forma de trabajar.
      </p>
      <p class="wuru-by reveal">Salud de calidad, accesible para todos.</p>
    </div>
  </div>
</section>

<style>
  .wuru {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--fg);
    z-index: 1;
  }
  .wrap {
    width: 100%;
    max-width: var(--maxw, 1280px);
    margin: 0 auto;
    padding: 0 var(--gutter);
    position: relative;
    z-index: 1;
  }

  /* wordmark gigante en outline (capa lenta) */
  .wuru-mark {
    position: absolute;
    right: 1%;
    bottom: -7%;
    font-size: 33vw;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--fg) 12%, transparent);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
    will-change: transform;
  }

  .wuru-content {
    position: relative;
    max-width: 940px;
    padding-left: clamp(28px, 4vw, 60px);
  }
  .wuru-content::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--accent), transparent 88%);
  }

  .eyebrow {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .wuru-quote {
    margin: 26px 0 0;
    font-size: clamp(32px, 5vw, 68px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .wuru-quote em {
    font-style: normal;
    color: var(--accent);
  }
  .wuru-lead {
    margin: 34px 0 0;
    max-width: 600px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--fg-muted);
  }
  .wuru-by {
    margin: 22px 0 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* entrada / salida en secuencia */
  .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wuru.in-view .reveal {
    opacity: 1;
    transform: none;
  }
  .wuru.in-view .reveal:nth-child(1) { transition-delay: 0.05s; }
  .wuru.in-view .reveal:nth-child(2) { transition-delay: 0.16s; }
  .wuru.in-view .reveal:nth-child(3) { transition-delay: 0.3s; }
  .wuru.in-view .reveal:nth-child(4) { transition-delay: 0.4s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .wuru-mark {
      transform: none !important;
    }
  }
  @media only screen and (max-width: 768px) {
    .wuru-mark {
      font-size: 48vw;
    }
    .wuru-content {
      max-width: 100%;
    }
  }
</style>
