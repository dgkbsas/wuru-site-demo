<script>
  const texts: string[] = ["LIMITLESS", "AGENTIC", "AUTONOMOUS", "EFFICIENT", "INNOVATIVE", "INTELLIGENT"];
  let currentIndex = 0;
  const delayBetweenLetters = 50;
  const delayBeforeNextWord = 2000;

  const animateLetters = (text: string): void => {
    const textElement = document.getElementById("animated-text");
    if (!textElement) return;

    textElement.innerHTML = "";

    text.split("").forEach((letter: string, index: number) => {
      const span = document.createElement("span");
      span.classList.add("letter");
      span.textContent = letter;

      setTimeout(() => {
        textElement.appendChild(span);
      }, index * delayBetweenLetters);
    });

    setTimeout(
      () => {
        changeText();
      },
      text.length * delayBetweenLetters + delayBeforeNextWord
    );
  };

  const changeText = (): void => {
    currentIndex = (currentIndex + 1) % texts.length;
    const nextText = texts[currentIndex];
    animateLetters(nextText);
  };

  document.addEventListener("DOMContentLoaded", () => {
    // Espera a que entren cubo y panel antes de tipear
    setTimeout(() => animateLetters(texts[currentIndex]), 800);
  });
</script>

<div id="animated-text" class="text-container"></div>

<style lang="scss">
  @keyframes animate-letter {
    0% {
      transform: translateY(-3px);
      opacity: 0;
    }
    100% {
      transform: translateY(0px);
      opacity: 1;
    }
  }

  :global(#animated-text .letter) {
    display: inline-block;
    opacity: 1;
    white-space: pre; /* preserva el ancho del espacio en "SIN LÍMITES" */
    animation: animate-letter 0.2s ease-out;
  }
  .text-container {
    /* fluido: en pantallas chicas la palabra más larga ("LIMITLESS") entraba
       cortada con el tamaño fijo de 80px */
    font-size: clamp(36px, 10.5vw, 80px);
    overflow: hidden;
  }

  #animated-text {
    height: 1.25em;
    color: var(--fg);
    font-weight: 900;
    letter-spacing: 1px;
  }
</style>
