---
import HeroTextChanging from "./HeroTextChanging.astro";
---

<div class="hero-text-container">
  <span class="hero-badge">
    <span class="live-dot"></span>
    Agentic operating platform for healthcare
  </span>
  <HeroTextChanging />
  <h1>Healthcare work</h1>
  <h3 class="tagline-1">Wúru runs the workflows that run your hospital</h3>
  <p class="tagline-2">One operating system for clinical work</p>
  <div class="line"></div>
  <a class="product-btn" href="mailto:hola@wuru.ai?subject=W%C3%BAru%20Demo" title="Book a demo" rel="noopener noreferrer">BOOK A DEMO</a>
</div>

<style lang="scss">
  @keyframes text-in-slide {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes login-appears {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(255, 99, 68, 0.6);
    }
    50% {
      opacity: 0.45;
      box-shadow: 0 0 0 6px rgba(255, 99, 68, 0);
    }
  }
  .hero-text-container {
    position: relative;
    z-index: 2; /* texto (y su sombra) por delante del cubo */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    left: 6%;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    border-radius: 100px;
    border: 0.5px solid #7d1703a0;
    background: rgba(127, 127, 127, 0.14);
    color: var(--fg);
    font-size: 14px;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    opacity: 0;
    animation: login-appears 0.3s ease-out 0.7s both;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6344;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(255, 99, 68, 0.8);
    animation: live-pulse 1.6s ease-in-out infinite;
  }
  h1 {
    margin: 0;
    font-size: 60px;
    font-weight: 500;
    color: var(--fg);
    animation: text-in-slide 0.35s ease-out 0.75s both;
  }
  h3 {
    margin: 0;
    font-size: 32px;
    color: var(--accent);
    font-weight: 400;
    animation: text-in-slide 0.35s ease-out 0.85s both;
  }
  .tagline-1 {
    max-width: 460px;
    margin-top: 12px;
  }
  .tagline-2 {
    margin: 8px 0 0;
    font-size: 17px;
    font-weight: 400;
    color: var(--fg-muted);
    max-width: 460px;
    animation: text-in-slide 0.35s ease-out 0.95s both;
  }
  .line {
    height: 0.5px;
    width: 200px;
    background-color: #ec5a3d;
    border-radius: 0.5px;
    margin-top: 16px;
    opacity: 0.7;
    animation-delay: 0.4s;
    filter: drop-shadow(0 2px 5px rgba(255, 0, 0, 0.8));
  }
  .product-btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    background: var(--accent);
    border: none;
    padding: 15px 32px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 100px;
    letter-spacing: 0.5px;
    cursor: pointer;
    margin-top: 32px;
    opacity: 0;
    animation: login-appears 0.3s ease-out 1.05s both;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      filter: brightness(1.08);
      box-shadow: 0 12px 30px rgba(236, 90, 61, 0.32);
    }
  }

  @media only screen and (max-width: 1024px) {
    .hero-text-container {
      position: unset !important;
      align-items: center !important;
    }
  }

  @media only screen and (max-width: 480px) {
    .hero-text-container {
      h1 {
        font-size: 32px !important;
      }
      h3 {
        font-size: 20px !important;
      }
    }
  }
</style>
