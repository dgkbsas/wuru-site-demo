---
import HeroTextChanging from "./HeroTextChanging.astro";
---

<div class="hero-text-container">
  <span class="hero-badge hl-line" style="--i: 0">
    <span class="live-dot"></span>
    Agentic operating platform for healthcare
  </span>
  <div class="hl-line" style="--i: 1"><HeroTextChanging /></div>
  <h1 class="hl-line" style="--i: 2">Healthcare work</h1>
  <h3 class="tagline-1 hl-line" style="--i: 3">Moving healthcare operations forward</h3>
  <div class="line hl-line" style="--i: 4"></div>
  <p class="purpose hl-line" style="--i: 5">Quality healthcare, accessible to everyone.</p>
  <a class="product-btn hl-line" style="--i: 6" href="mailto:hola@wuru.ai?subject=W%C3%BAru%20Demo" title="Book a demo" rel="noopener noreferrer">BOOK A DEMO</a>
</div>

<style lang="scss">
  @keyframes text-in-slide {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes login-appears {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(255, 99, 68, 0.6);
    }
    50% {
      opacity: 0.45;
      box-shadow: 0 0 0 6px rgba(255, 99, 68, 0);
    }
  }
  .hero-text-container {
    position: relative;
    z-index: 2; /* texto por delante del cubo */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
  }

  /* animación por línea (in/out), disparada por .hero-in en el wrap padre */
  .hl-line {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 0.07s);
  }
  :global(.hero-in) .hl-line {
    opacity: 1;
    transform: none;
  }
  /* el botón: opacity only (su transform lo manejan los springs de hover/press) */
  .product-btn.hl-line {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hl-line {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    border-radius: 100px;
    border: 0.5px solid #7d1703a0;
    background: rgba(200, 190, 195, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--fg);
    font-size: 14px;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6344;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(255, 99, 68, 0.8);
    animation: live-pulse 1.6s ease-in-out infinite;
  }
  h1 {
    margin: -16px 0 0; /* acerca "Healthcare workflows" al animated text de arriba */
    font-size: 60px;
    font-weight: 500;
    color: var(--fg);
  }
  h3 {
    margin: 0;
    font-size: 32px;
    color: var(--accent);
    font-weight: 400;
  }
  .tagline-1 {
    max-width: 520px;
    margin-top: 12px;
    /* en el primary de la marca, que no cambia con el tema */
    color: var(--brand);
  }
  .line {
    height: 0.5px;
    width: 200px;
    background-color: #ec5a3d;
    border-radius: 0.5px;
    margin-top: 16px;
    filter: drop-shadow(0 2px 5px rgba(255, 0, 0, 0.8));
  }
  /* el propósito: después de la línea, en su propia zona — no compite con la
     tagline (que dice qué hacemos) porque dice para qué */
  .purpose {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .product-btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    background: var(--accent);
    border: none;
    padding: 15px 32px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 100px;
    letter-spacing: 0.5px;
    cursor: pointer;
    margin-top: 24px;
    transition:
      opacity 0.5s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      filter: brightness(1.08);
      box-shadow: 0 12px 30px rgba(236, 90, 61, 0.32);
    }
  }

  @media only screen and (max-width: 1024px) {
    /* se mantiene alineado a la izquierda como en desktop: centrar el bloque
       pero dejar el texto en bandera generaba una mezcla despareja */
    .hero-text-container {
      position: unset;
      align-items: flex-start;
      max-width: 100%;
    }
    h1 {
      font-size: clamp(30px, 8.5vw, 60px);
      margin-top: -8px;
    }
    h3 {
      font-size: clamp(19px, 5.4vw, 32px);
    }
    .tagline-1 {
      max-width: 100%;
    }
    .hero-badge {
      font-size: 12.5px;
      padding: 6px 13px;
    }
  }
</style>
