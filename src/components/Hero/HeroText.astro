---
import HeroTextChanging from "./HeroTextChanging.astro";
---

<div class="hero-text-container">
  <span class="hero-badge">
    <span class="live-dot"></span>
    Plataforma operativa agéntica para la salud
  </span>
  <h1>El trabajo en salud</h1>
  <HeroTextChanging />
  <h3 class="tagline-1">Wúru opera los flujos de trabajo que hacen funcionar tu hospital</h3>
  <p class="tagline-2">Un solo sistema operativo para el trabajo clínico</p>
  <div class="line"></div>
  <a class="product-btn" href="mailto:hola@wuru.ai?subject=Demo%20de%20W%C3%BAru" title="Agendar una demo" rel="noopener noreferrer">AGENDAR UNA DEMO</a>
</div>

<style lang="scss">
  @keyframes text-in-slide {
    0% {
      opacity: 0;
      transform: translateX(10px);
    }
    100% {
      opacity: 1;
      transform: translateX(0px);
    }
  }

  @keyframes login-appears {
    0% {
      opacity: 0;
      transform: scale(0.9);
    }
    80% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(255, 99, 68, 0.6);
    }
    50% {
      opacity: 0.45;
      box-shadow: 0 0 0 6px rgba(255, 99, 68, 0);
    }
  }
  .hero-text-container {
    position: relative;
    z-index: 2; /* texto (y su sombra) por delante del cubo */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    left: 6%;
  }
  /* Sombra oscura difusa detrás de todo el bloque de texto, para separarlo del cubo */
  .hero-text-container::before {
    content: "";
    position: absolute;
    inset: -90px -200px -70px -130px;
    background: radial-gradient(
      ellipse at 38% 50%,
      rgba(0, 0, 0, 0.74) 0%,
      rgba(0, 0, 0, 0.5) 48%,
      transparent 78%
    );
    filter: blur(30px);
    z-index: -1;
    pointer-events: none;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    border-radius: 100px;
    border: 0.5px solid #7d1703a0;
    background: rgba(255, 255, 255, 0.03);
    color: #f1f1f1;
    font-size: 14px;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    opacity: 0;
    animation: login-appears 0.2s ease-out forwards;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6344;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(255, 99, 68, 0.8);
    animation: live-pulse 1.6s ease-in-out infinite;
  }
  h1 {
    margin: 0;
    font-size: 46px;
    font-weight: 500;
    color: #f1f1f1;
    animation: text-in-slide 0.2s ease-out forwards;
  }
  h3 {
    margin: 0;
    font-size: 28px;
    color: #ec5a3d;
    font-weight: 400;
    animation: text-in-slide 0.2s ease-out forwards;
    animation-delay: 0.2s;
    filter: drop-shadow(0 2px 5px rgba(255, 0, 0, 0.5));
  }
  .tagline-1 {
    max-width: 460px;
    margin-top: 12px;
  }
  .tagline-2 {
    margin: 8px 0 0;
    font-size: 17px;
    font-weight: 400;
    color: #f1f1f1;
    opacity: 0.65;
    max-width: 460px;
    animation: text-in-slide 0.2s ease-out forwards;
    animation-delay: 0.3s;
  }
  .line {
    height: 0.5px;
    width: 100px;
    background-color: #ec5a3d;
    border-radius: 0.5px;
    margin-top: 16px;
    opacity: 0.7;
    animation-delay: 0.4s;
    filter: drop-shadow(0 2px 5px rgba(255, 0, 0, 0.8));
  }
  .product-btn {
    text-decoration: none;
    color: #f1f1f1;
    background-image: linear-gradient(to right top, #281722, #391725, #491722, #57181a, #601f0c);
    border: solid 0.25px #7d170363;
    padding: 8px 48px;
    font-size: 14px;
    border-radius: 24px;
    transition: all 0.2s ease-in-out;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: 32px;
    box-shadow:
      5px 5px 20px 0px #000000,
      -5px -5px 20px 0px #400000;
    opacity: 0;
    animation: login-appears 0.2s ease-out forwards;
    animation-delay: 0.5s;

    &:hover {
      border: solid 0.25px #7d1703bf;
    }
  }

  @media only screen and (max-width: 1024px) {
    .hero-text-container {
      position: unset !important;
      align-items: center !important;
    }
  }

  @media only screen and (max-width: 480px) {
    .hero-text-container {
      h1 {
        font-size: 32px !important;
      }
      h3 {
        font-size: 20px !important;
      }
    }
  }
</style>
