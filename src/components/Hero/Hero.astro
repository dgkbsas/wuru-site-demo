---
import HeroText from "./HeroText.astro";
---

<script>
  import { animate, hover, press, scroll } from "motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Springs en botones (hover + press con física)
  if (!reduce) {
    const springy = (sel: string) => {
      const el = document.querySelector<HTMLElement>(sel);
      if (!el) return;
      hover(el, () => {
        animate(el, { scale: 1.04 }, { type: "spring", stiffness: 400, damping: 16 });
        return () => animate(el, { scale: 1 }, { type: "spring", stiffness: 380, damping: 22 });
      });
      press(el, () => {
        animate(el, { scale: 0.96 }, { type: "spring", stiffness: 500, damping: 22 });
        return () => animate(el, { scale: 1.04 }, { type: "spring", stiffness: 400, damping: 16 });
      });
    };
    springy(".product-btn");
    springy(".log-in-btn");
  }

  // Animación por línea del hero (cada línea con su propio delay, en CSS).
  // Es de UNA SOLA VÍA: entra una vez y queda fija — no anima la salida.
  const heroWrap = document.querySelector<HTMLElement>(".hero-text-wrap");
  requestAnimationFrame(() => heroWrap?.classList.add("hero-in"));

  // El video entra con fade sobre el placeholder borroso (nunca hay hueco).
  // Con reduced-motion se pausa: queda el primer frame como imagen fija.
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero-scene-img");
  if (heroVideo) {
    const reveal = () => heroVideo.setAttribute("data-loaded", "");
    if (heroVideo.readyState >= 2) reveal();
    else heroVideo.addEventListener("loadeddata", reveal, { once: true });
    if (reduce) heroVideo.pause();
  }

  // Parallax: la imagen se mueve más lento que la página al salir el hero, y el
  // texto sale más rápido → sensación de capas (sin snap duro ya se lee bien).
  const heroEl = document.querySelector<HTMLElement>(".hero");
  const sceneImg = document.querySelector<HTMLElement>(".hero-scene-img");
  const heroScene = document.querySelector<HTMLElement>(".hero-scene");
  if (heroEl && sceneImg && !reduce) {
    scroll(animate(sceneImg, { y: [0, 230] }, { ease: "linear" }), {
      target: heroEl,
      offset: ["start start", "end start"],
    });
    // la escena se apaga un poco al salir: limpia el pase a la sección siguiente
    if (heroScene) {
      scroll(animate(heroScene, { opacity: [1, 0.45] }, { ease: "linear" }), {
        target: heroEl,
        offset: ["center start", "end start"],
      });
    }
    // el texto se adelanta (capa más cercana)
    if (heroWrap) {
      scroll(animate(heroWrap, { y: [0, -70] }, { ease: "linear" }), {
        target: heroEl,
        offset: ["start start", "end start"],
      });
    }
  }
</script>

<section class="hero">
  <div class="hero-stage">
    <!-- Escena del hero: el loop se sirve TAL CUAL sale de Premiere (sin
         re-encodear, para no perder calidad). El contenedor lleva un
         placeholder diminuto (base64, borroso) para que no haya hueco. -->
    <div class="hero-scene">
      <video
        class="hero-scene-img"
        poster="/video/hero-poster.webp"
        preload="metadata"
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      >
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Texto del hero -->
    <div class="hero-text-wrap">
      <HeroText />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    scroll-snap-align: start;
    /* El fondo del hero es una imagen clara fija → texto oscuro siempre
       (independiente del tema), para contraste consistente. */
    --fg: #1d1119;
    --fg-muted: rgba(29, 17, 25, 0.66);
  }

  .hero-stage {
    position: absolute;
    inset: 0;
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Escena de fondo (imagen / futuro video) */
  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    animation: scene-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  /* placeholder de 32px en base64: color y forma desde el primer milisegundo,
     sin una sola petición de red */
  .hero-scene::before {
    content: "";
    position: absolute;
    inset: -4%;
    z-index: 0;
    background: url("data:image/jpeg;base64,") center / cover no-repeat;
    filter: blur(24px);
    transform: scale(1.04);
  }
  /* video sobredimensionado: deja "aire" arriba/abajo para el parallax sin huecos */
  .hero-scene-img {
    position: absolute;
    top: -18%;
    left: 0;
    width: 100%;
    height: 136%;
    object-fit: cover;
    object-position: 70% center;
    display: block;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .hero-scene-img[data-loaded] {
    opacity: 1;
  }

  /* Texto del hero: a la izquierda, centrado vertical */
  .hero-text-wrap {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: calc(var(--gutter) + 48px);
    padding-right: var(--gutter);
  }

  /* Fallback simple para pantallas chicas (responsive fino queda para después) */
  @media only screen and (max-width: 1024px) {
    .hero {
      min-height: 92vh;
    }
    .hero-scene-img {
      object-position: 62% center;
    }
    /* el texto sube: abajo queda visible la acción del video */
    .hero-text-wrap {
      align-items: flex-start;
      padding-top: clamp(88px, 14vh, 130px);
    }
    /* se aclara sólo la franja de arriba, donde apoya el texto */
    .hero-scene::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(246, 244, 247, 0.88) 0%,
        rgba(246, 244, 247, 0.6) 30%,
        rgba(246, 244, 247, 0.15) 52%,
        transparent 66%
      );
    }
    .hero-text-wrap {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
