---
import HeroText from "./HeroText.astro";

// Assets del hero. Los nombres llevan hash de contenido a propósito: vercel.json
// sirve /video/* como `immutable` a un año, así que un export nuevo TIENE que
// cambiar de nombre — si no, queda cacheado el viejo para siempre.
// Dos resoluciones × dos codecs: un teléfono de 390pt@3x muestra ~1170px, así
// que mandarle el master de 2560 son 4x los píxeles que puede ver.
const VIDEO = {
  poster: "/video/hero-poster.cc233694.webp",
  desktopWebm: "/video/hero.404200f8.webm", // VP9, 1.5 MB
  desktopMp4: "/video/hero.74358575.mp4", //  master de Premiere, 14 MB
  mobileWebm: "/video/hero-m.78d2ced1.webm", // VP9 @1280, 505 KB
  mobileMp4: "/video/hero-m.1fcafeb5.mp4", //  h264 @1280, 905 KB
};
---

<script>
  import { animate, hover, press, scroll } from "motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Springs en botones (hover + press con física)
  if (!reduce) {
    const springy = (sel: string) => {
      const el = document.querySelector<HTMLElement>(sel);
      if (!el) return;
      hover(el, () => {
        animate(el, { scale: 1.04 }, { type: "spring", stiffness: 400, damping: 16 });
        return () => animate(el, { scale: 1 }, { type: "spring", stiffness: 380, damping: 22 });
      });
      press(el, () => {
        animate(el, { scale: 0.96 }, { type: "spring", stiffness: 500, damping: 22 });
        return () => animate(el, { scale: 1.04 }, { type: "spring", stiffness: 400, damping: 16 });
      });
    };
    springy(".product-btn");
    springy(".log-in-btn");
  }

  // Animación por línea del hero (cada línea con su propio delay, en CSS).
  // Es de UNA SOLA VÍA: entra una vez y queda fija — no anima la salida.
  const heroWrap = document.querySelector<HTMLElement>(".hero-text-wrap");
  requestAnimationFrame(() => heroWrap?.classList.add("hero-in"));

  // El video entra con fade sobre el placeholder borroso (nunca hay hueco).
  // Con reduced-motion se pausa: queda el primer frame como imagen fija.
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero-scene-img");
  if (heroVideo) {
    // se acelera desde el player (no re-encodeando) → cero pérdida de calidad
    const SPEED = 1.2;
    const setSpeed = () => (heroVideo.playbackRate = SPEED);
    heroVideo.addEventListener("loadedmetadata", setSpeed);
    heroVideo.addEventListener("play", setSpeed);

    // El poster es el mismo primer frame del loop: se muestra apenas está y
    // después el video lo reemplaza sin que se note el cambio.
    const reveal = () => heroVideo.setAttribute("data-loaded", "");
    const posterImg = new Image();
    posterImg.onload = reveal;
    posterImg.onerror = reveal;
    posterImg.src = heroVideo.poster;

    // Qué archivo pedir: la resolución la define el viewport, el codec lo define
    // el soporte real del navegador. Se resuelve acá y no con <source media>
    // porque ese atributo no tiene soporte uniforme — justamente en iOS Safari,
    // que es el mobile que importa.
    const d = heroVideo.dataset;
    const chico = window.matchMedia("(max-width: 1024px)").matches;
    const vp9 = heroVideo.canPlayType('video/webm; codecs="vp9"') !== "";
    const src = chico ? (vp9 ? d.webmM : d.mp4M) : vp9 ? d.webm : d.mp4;

    // Con reduced-motion no se descarga nada: el poster ya dice lo mismo.
    if (!reduce && src) {
      const arrancar = () => {
        if (heroVideo.src) return;
        heroVideo.src = src;
        heroVideo.load();
        setSpeed();
        heroVideo.play()?.catch(() => {});
      };
      // recién cuando la página está interactiva: así el video no le compite
      // el ancho de banda al resto, y quien rebota enseguida no se lo baja
      const idle = (cb: () => void) =>
        "requestIdleCallback" in window
          ? (window as any).requestIdleCallback(cb, { timeout: 1500 })
          : setTimeout(cb, 200);
      if (document.readyState === "complete") idle(arrancar);
      else window.addEventListener("load", () => idle(arrancar), { once: true });
    }
  }

  // Parallax: la imagen se mueve más lento que la página al salir el hero, y el
  // texto sale más rápido → sensación de capas (sin snap duro ya se lee bien).
  const heroEl = document.querySelector<HTMLElement>(".hero");
  const sceneImg = document.querySelector<HTMLElement>(".hero-scene-img");
  const heroScene = document.querySelector<HTMLElement>(".hero-scene");
  if (heroEl && sceneImg && !reduce) {
    scroll(animate(sceneImg, { y: [0, 230] }, { ease: "linear" }), {
      target: heroEl,
      offset: ["start start", "end start"],
    });
    // la escena se apaga un poco al salir: limpia el pase a la sección siguiente
    if (heroScene) {
      scroll(animate(heroScene, { opacity: [1, 0.45] }, { ease: "linear" }), {
        target: heroEl,
        offset: ["center start", "end start"],
      });
    }
    // el texto se adelanta (capa más cercana)
    if (heroWrap) {
      scroll(animate(heroWrap, { y: [0, -70] }, { ease: "linear" }), {
        target: heroEl,
        offset: ["start start", "end start"],
      });
    }
  }
</script>

<section class="hero">
  <div class="hero-stage">
    <!-- Escena del hero: el loop se sirve TAL CUAL sale de Premiere (sin
         re-encodear, para no perder calidad). El contenedor lleva un
         placeholder diminuto (base64, borroso) para que no haya hueco. -->
    <div class="hero-scene">
      <!-- sin src: la fuente la elige el script según viewport y codec, y la
           carga arranca cuando la página ya está interactiva. Mientras tanto se
           ve el poster (30 KB), que es el mismo primer frame. -->
      <video
        class="hero-scene-img"
        poster={VIDEO.poster}
        preload="none"
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
        data-webm={VIDEO.desktopWebm}
        data-mp4={VIDEO.desktopMp4}
        data-webm-m={VIDEO.mobileWebm}
        data-mp4-m={VIDEO.mobileMp4}></video>
      <!-- sin JS no hay video: que al menos se vea el poster nítido -->
      <noscript><style>.hero-scene-img { opacity: 1 !important; }</style></noscript>
    </div>

    <!-- Texto del hero -->
    <div class="hero-text-wrap">
      <HeroText />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    scroll-snap-align: start;
    /* El fondo del hero es una imagen clara fija → texto oscuro siempre
       (independiente del tema), para contraste consistente. */
    --fg: #1d1119;
    --fg-muted: rgba(29, 17, 25, 0.66);
  }

  .hero-stage {
    position: absolute;
    inset: 0;
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Escena de fondo (imagen / futuro video) */
  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    animation: scene-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  /* placeholder de 32px en base64: color y forma desde el primer milisegundo,
     sin una sola petición de red */
  .hero-scene::before {
    content: "";
    position: absolute;
    inset: -4%;
    z-index: 0;
    background: url("data:image/jpeg;base64,") center / cover no-repeat;
    filter: blur(24px);
    transform: scale(1.04);
  }
  /* video sobredimensionado: deja "aire" arriba/abajo para el parallax sin huecos */
  .hero-scene-img {
    position: absolute;
    top: -18%;
    left: 0;
    width: 100%;
    height: 136%;
    object-fit: cover;
    object-position: 70% center;
    display: block;
    opacity: 0;
    transition: opacity 0.45s ease;
    /* grading por CSS (no re-encodeado): blanquea los azulejos y aviva el neón,
       lo que además ayuda al contraste del texto oscuro de la izquierda */
    filter: contrast(1.24) saturate(1.2) brightness(1.02);
  }
  .hero-scene-img[data-loaded] {
    opacity: 1;
  }
  /* velo claro por encima del video: este grade es más oscuro, y el texto del
     hero es oscuro fijo → asegura contraste sin lavar la escena de la derecha */
  .hero-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        100deg,
        rgba(248, 246, 249, 0.72) 0%,
        rgba(248, 246, 249, 0.5) 24%,
        rgba(248, 246, 249, 0.16) 48%,
        transparent 66%
      ),
      linear-gradient(180deg, rgba(248, 246, 249, 0.3) 0%, transparent 26%);
  }

  /* Texto del hero: a la izquierda, centrado vertical */
  .hero-text-wrap {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: calc(var(--gutter) + 48px);
    padding-right: var(--gutter);
  }

  /* Fallback simple para pantallas chicas (responsive fino queda para después) */
  @media only screen and (max-width: 1024px) {
    .hero {
      min-height: 92vh;
    }
    .hero-scene-img {
      object-position: 62% center;
    }
    /* el texto sube: abajo queda visible la acción del video */
    .hero-text-wrap {
      align-items: flex-start;
      padding-top: clamp(88px, 14vh, 130px);
    }
    /* acá el texto va arriba (no a la izquierda): el velo pasa a franja superior */
    .hero-scene::after {
      background: linear-gradient(
        180deg,
        rgba(246, 244, 247, 0.88) 0%,
        rgba(246, 244, 247, 0.62) 30%,
        rgba(246, 244, 247, 0.18) 52%,
        transparent 66%
      );
    }
    .hero-text-wrap {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
