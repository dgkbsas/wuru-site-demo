---
import { Image } from "astro:assets";
import CAA from "../assets/images/CAA-logo.png";
import CHSF from "../assets/images/CHSF-logo.png";
import CUN from "../assets/images/CUN-logo.png";
import FSFB from "../assets/images/FSFB-logo.png";
import GG from "../assets/images/GG-logo.png";
import HA from "../assets/images/HA-logo.png";
import SMG from "../assets/images/SMG-logo.png";
import auna from "../assets/images/auna-logo.png";
import avidanti from "../assets/images/avidanti-logo.png";
import angeles from "../assets/images/hang-logo.png"; // "hang" = H-Ang → Hospital Angeles
import ledor from "../assets/images/ledor-logo.png";
import Boston from "../assets/images/boston-cientific.png";
import Microsoft from "../assets/images/microsoft.png";

// h: alto propio cuando el logo necesita otra escala para leerse igual
const logos = [
  { src: auna, alt: "Auna" },
  { src: avidanti, alt: "Avidanti" },
  { src: angeles, alt: "Hospital Angeles Health System" },
  { src: ledor, alt: "Ledor Vador", big: true },
  { src: FSFB, alt: "Fundación Santa Fe de Bogotá" },
  { src: CUN, alt: "Clínica Universidad de Navarra" },
  { src: SMG, alt: "Swiss Medical Group" },
  { src: CAA, alt: "Clínica Anglo Americana" },
  { src: CHSF, alt: "Clínica Hospital San Fernando" },
  { src: GG, alt: "Grupo Gamma" },
  { src: HA, alt: "Hospital Alemán" },
];
---

<div class="clients">
  <!-- el label lleva el claim: no "nos conocen" sino "está operando" -->
  <span class="clients-label is-claim">
    Running in real operating rooms and infusion centers across Latin America
  </span>
  <div class="clients-marquee">
    <ul class="marquee-track">
      {
        logos.map((l) => (
          <li>
            <Image src={l.src} alt={l.alt} height={44} class:list={["client-logo", { "is-big": l.big }]} loading="lazy" />
          </li>
        ))
      }
      {
        logos.map((l) => (
          <li aria-hidden="true">
            <Image src={l.src} alt="" height={44} class:list={["client-logo", { "is-big": l.big }]} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="partners">
    <span class="clients-label">In partnership with</span>
    <ul class="clients-row partners-row">
      <li><Image src={Boston} alt="Boston Scientific" height={40} class="partner-logo" loading="lazy" /></li>
      <li><Image src={Microsoft} alt="Microsoft Partner" height={30} class="partner-logo is-small" loading="lazy" /></li>
      <li><Image src={HA} alt="Hospital Alemán" height={40} class="partner-logo" loading="lazy" /></li>
      <li><Image src={GG} alt="Grupo Gamma" height={44} class="partner-logo" loading="lazy" /></li>
      <li><Image src={angeles} alt="Hospital Angeles Health System" height={38} class="partner-logo is-mid" loading="lazy" /></li>
    </ul>
  </div>
</div>

<style>
  .clients {
    margin-top: 30px;
  }
  /* el label que afirma la operación real: sin mayúsculas, un punto más grande */
  .clients-label.is-claim {
    max-width: 56ch;
    margin-inline: auto;
    text-transform: none;
    letter-spacing: 0;
    font-size: 14.5px;
    line-height: 1.5;
    text-wrap: balance;
    opacity: 1;
  }
  .clients-label {
    display: block;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--fg-muted);
    opacity: 0.85;
  }
  /* banner marquee de clients: logos deslizan y se desvanecen en los bordes */
  .clients-marquee {
    margin-top: 14px;
    width: 100%;
    max-width: 920px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .marquee-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee 34s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  .marquee-track li {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    margin-right: 56px; /* margin (no gap) para que translateX(-50%) sea sin salto */
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* fila estática (partners) */
  .clients-row {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 40px;
  }
  .clients-row li {
    display: flex;
    align-items: center;
  }
  .client-logo {
    height: 34px;
    width: auto;
    filter: var(--logo-filter, none);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .client-logo:hover {
    opacity: 0.9;
  }
  /* logos que necesitan más escala para leerse igual que el resto */
  .client-logo.is-big {
    height: 54px;
  }
  .partners {
    margin-top: clamp(24px, 3.2vh, 36px);
  }
  .partners-row {
    margin-top: 14px;
    gap: 26px 34px;
  }
  .partner-logo {
    height: 44px;
    width: auto;
    filter: var(--logo-filter, none);
    opacity: 0.62;
    transition: opacity 0.25s ease;
  }
  .partner-logo:hover {
    opacity: 0.92;
  }
  .partner-logo.is-big {
    height: 64px;
  }
  .partner-logo.is-small {
    height: 30px;
  }
  .partner-logo.is-mid {
    height: 38px;
  }

  @media only screen and (max-width: 1024px) {
    .clients-row {
      gap: 22px 28px;
    }
    .client-logo {
      height: 26px;
    }
    .client-logo.is-big {
      height: 40px;
    }
    .partner-logo.is-big {
      height: 52px;
    }
    .partner-logo.is-small {
      height: 24px;
    }
    .partner-logo.is-mid {
      height: 32px;
    }
    .marquee-track li {
      margin-right: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-marquee {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      row-gap: 20px;
    }
    .marquee-track li[aria-hidden="true"] {
      display: none;
    }
  }
</style>
