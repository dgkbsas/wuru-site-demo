---
import { Image } from "astro:assets";
import CAA from "../assets/images/CAA-logo.png";
import CHSF from "../assets/images/CHSF-logo.png";
import CUN from "../assets/images/CUN-logo.png";
import FSFB from "../assets/images/FSFB-logo.png";
import GG from "../assets/images/GG-logo.png";
import HA from "../assets/images/HA-logo.png";
import SMG from "../assets/images/SMG-logo.png";
import auna from "../assets/images/auna-logo.png";
import avidanti from "../assets/images/avidanti-logo.png";
import hang from "../assets/images/hang-logo.png";
import Boston from "../assets/images/boston-cientific.png";
import Microsoft from "../assets/images/microsoft.png";

const logos = [
  { src: auna, alt: "Auna" },
  { src: avidanti, alt: "Avidanti" },
  { src: hang, alt: "Hang" },
  { src: FSFB, alt: "Fundación Santa Fe de Bogotá" },
  { src: CUN, alt: "Clínica Universidad de Navarra" },
  { src: SMG, alt: "Swiss Medical Group" },
  { src: CAA, alt: "CAA" },
  { src: CHSF, alt: "CHSF" },
  { src: GG, alt: "GG" },
  { src: HA, alt: "HA" },
];
---

<div class="clients">
  <span class="clients-label">Trusted by leading healthcare institutions</span>
  <div class="clients-marquee">
    <ul class="marquee-track">
      {
        logos.map((l) => (
          <li>
            <Image src={l.src} alt={l.alt} height={38} class="client-logo" loading="lazy" />
          </li>
        ))
      }
      {
        logos.map((l) => (
          <li aria-hidden="true">
            <Image src={l.src} alt="" height={38} class="client-logo" loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="partners">
    <span class="clients-label">In partnership with</span>
    <ul class="clients-row partners-row">
      <li><Image src={Boston} alt="Boston Scientific" height={40} class="partner-logo" loading="lazy" /></li>
      <li><Image src={Microsoft} alt="Microsoft Partner" height={30} class="partner-logo" loading="lazy" /></li>
    </ul>
  </div>
</div>

<style>
  .clients {
    margin-top: 44px;
  }
  .clients-label {
    display: block;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--fg-muted);
    opacity: 0.85;
  }
  /* banner marquee de clients: logos deslizan y se desvanecen en los bordes */
  .clients-marquee {
    margin-top: 18px;
    max-width: 640px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .marquee-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee 34s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  .marquee-track li {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    margin-right: 56px; /* margin (no gap) para que translateX(-50%) sea sin salto */
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* fila estática (partners) */
  .clients-row {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 40px;
  }
  .clients-row li {
    display: flex;
    align-items: center;
  }
  .client-logo {
    height: 34px;
    width: auto;
    filter: var(--logo-filter, none);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .client-logo:hover {
    opacity: 0.9;
  }
  .partners {
    margin-top: 36px;
  }
  .partners-row {
    margin-top: 14px;
    gap: 26px 34px;
  }
  .partner-logo {
    height: 44px;
    width: auto;
    filter: var(--logo-filter, none);
    opacity: 0.62;
    transition: opacity 0.25s ease;
  }
  .partner-logo:hover {
    opacity: 0.92;
  }

  @media only screen and (max-width: 1024px) {
    .clients-row {
      gap: 22px 28px;
    }
    .client-logo {
      height: 26px;
    }
    .marquee-track li {
      margin-right: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-marquee {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      row-gap: 20px;
    }
    .marquee-track li[aria-hidden="true"] {
      display: none;
    }
  }
</style>
