---
// Acento discreto de WÚRU: 4 capas isométricas chicas, fills claros y borde rojo,
// flotando a la altura del texto (izquierda). Entrada/salida direccional (según
// de qué sección se venga) + float sutil. Pasan desapercibidas.
---

<div class="wuru-layers" aria-hidden="true">
  <div class="stack">
    <div class="layer" style="--z: 70px;  --d-stack: 0s;    --d-float: 1.0s;"></div>
    <div class="layer" style="--z: 23px;  --d-stack: 0.13s; --d-float: 1.5s; --tint: 236, 90, 61;"></div>
    <div class="layer" style="--z: -23px; --d-stack: 0.26s; --d-float: 2.0s;"></div>
    <div class="layer" style="--z: -70px; --d-stack: 0.39s; --d-float: 2.5s;"></div>
  </div>
</div>

<script>
  // Las layers entran UNA VEZ y quedan fijas (no animan la salida). Sólo antes
  // de la primera entrada se define la dirección desde la que se apilan:
  // si venimos de arriba (hero) entran desde abajo, y al revés.
  const order = ["inicio", "wuru", "plataforma"];
  const wuruIdx = order.indexOf("wuru");
  const el = document.querySelector<HTMLElement>(".wuru-layers");
  let entered = false;
  window.addEventListener("deckchange", (e) => {
    const raw = (e as CustomEvent).detail?.id;
    // los sub-pasos del bloque Platform (ax-0/1/2) cuentan como "plataforma"
    const id = typeof raw === "string" && raw.startsWith("ax-") ? "plataforma" : raw;
    if (!el || !id) return;
    if (id === "wuru") {
      entered = true; // ya entraron: de acá en adelante no se toca nada
      return;
    }
    if (entered) return;
    const idx = order.indexOf(id);
    if (idx < 0) return;
    const above = idx < wuruIdx;
    el.style.setProperty("--off-y", above ? "40%" : "-40%");
    el.style.setProperty("--stack-z", above ? "-140px" : "140px");
    // orden del apilado: desde abajo → primero la de arriba; desde arriba → al revés
    const layers = Array.from(el.querySelectorAll<HTMLElement>(".layer"));
    layers.forEach((layer, i) => {
      const orderIdx = above ? i : layers.length - 1 - i;
      layer.style.setProperty("--d-stack", (orderIdx * 0.13).toFixed(2) + "s");
    });
  });
</script>

<style>
  .wuru-layers {
    --tint: 150, 130, 148; /* fill plum */
    --edge: 236, 90, 61; /* borde rojo Wúru */
    perspective: 1200px;
    width: 620px;
    height: 560px;
    display: grid;
    place-items: center;
    /* off (inactiva): fuera + transparente; dirección por --off-y */
    opacity: 0;
    transform: translateX(-48%) translateY(var(--off-y, 40%));
    transition:
      opacity 0.6s ease,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* reposo (activa): a la altura del texto, izquierda — opacidad baja (clarito) */
  :global(.deck-section.is-active) .wuru-layers {
    opacity: 0.5;
    transform: translateX(-48%) translateY(0);
  }

  .stack {
    position: relative;
    width: 480px;
    height: 480px;
    transform-style: preserve-3d;
    transform: rotateX(55deg) rotateZ(45deg);
  }

  .layer {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    /* fill translúcido plano (sin border ni backdrop-filter → estilo estable en toda la anim) */
    background: linear-gradient(
      135deg,
      rgba(var(--tint), 0.2),
      rgba(var(--tint), 0.07)
    );
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.08);
    opacity: 1;
    transform: translateZ(calc(var(--z) + var(--stack-z, -140px)));
    will-change: transform;
  }

  :global(.deck-section.is-active) .layer {
    animation:
      stack-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) var(--d-stack) both,
      layer-float 2.8s ease-in-out var(--d-float) infinite alternate;
  }

  @keyframes stack-in {
    from {
      transform: translateZ(calc(var(--z) + var(--stack-z, -140px)));
    }
    to {
      transform: translateZ(var(--z));
    }
  }
  @keyframes layer-float {
    from {
      transform: translateZ(var(--z));
    }
    to {
      transform: translateZ(calc(var(--z) + 16px));
    }
  }

  /* Es un grafismo decorativo de 620×560px: en pantallas chicas desbordaba el
     viewport (hasta +279px) y empujaba el layout. Se achica en tablet y se
     oculta en mobile, donde no aporta y sí estorba. */
  @media only screen and (max-width: 1024px) {
    .wuru-layers {
      width: 420px;
      height: 380px;
      transform: translateX(-30%) translateY(var(--off-y, 40%));
    }
    :global(.deck-section.is-active) .wuru-layers {
      transform: translateX(-30%) translateY(0);
    }
    .stack {
      width: 330px;
      height: 330px;
    }
  }
  @media only screen and (max-width: 700px) {
    .wuru-layers {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer {
      transform: translateZ(var(--z));
    }
    :global(.deck-section.is-active) .layer {
      animation: none;
    }
  }
</style>
