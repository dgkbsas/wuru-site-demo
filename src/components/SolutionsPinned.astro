---
// Bloque pineado que une Solutions, Security & trust y How we build en UNA sola
// sección: el fondo pleno queda fijo y al scrollear el contenido va pasando de
// una a la otra (mismo lenguaje que el bloque Platform, sin switcher).
import Solutions from "./Solutions.astro";
import Security from "./Security.astro";
import HowWeBuild from "./HowWeBuild.astro";

const steps = [
  {
    id: "solutions",
    eyebrow: "Solutions",
    title: "One platform, applied to real operations.",
    body: "Each area is an end-to-end problem — and inside it the three axes combine according to what that problem needs.",
  },
  {
    id: "security",
    eyebrow: "Security & trust",
    title: "Designed for the confidentiality demands of clinical work.",
    body: "Wúru is built to operate inside the hospital's existing infrastructure and to meet the highest standards for handling protected health data.",
  },
  {
    id: "how-we-build",
    eyebrow: "How we build",
    title: "We build with AI the same way we build AI.",
    body: "We embed intelligent agents into our products — and into the way we work.",
  },
];
---

<section class="sp" id="solutions-security">
  <!-- fondo pleno de la sección (fijo), con textura en parallax -->
  <div class="sp-fill" aria-hidden="true">
    <div class="sp-fill-dots"></div>
    <div class="sp-fill-inner"></div>
  </div>

  <div class="sp-stage">
    <div class="sp-inner">
      <!-- indicador mínimo: 3 dots, sin fondo -->
      <div class="sp-dots">
        {steps.map((s, i) => (
          <button
            type="button"
            class={`sp-dot${i === 0 ? " is-on" : ""}`}
            data-step={i}
            aria-label={s.eyebrow}
          />
        ))}
      </div>

      <div class="sp-panels">
        {steps.map((s, i) => (
          <div class={`sp-panel${i === 0 ? " is-on" : ""}`} data-step={i}>
            <div class="sp-head">
              <span class="sp-eyebrow">{s.eyebrow}</span>
              <h2 class="sp-title">{s.title}</h2>
              <p class="sp-body">{s.body}</p>
            </div>
            <div class="sp-content">
              {i === 0 ? <Solutions /> : i === 1 ? <Security /> : <HowWeBuild />}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- markers: dan el recorrido y llevan el id de cada paso (para el picker) -->
  <div class="sp-markers" aria-hidden="true">
    {steps.map((s, i) => <div class="sp-marker" id={s.id} data-step={i}></div>)}
  </div>
</section>

<script>
  import { animate, scroll } from "motion";

  const section = document.querySelector<HTMLElement>(".sp");
  if (section) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const panels = Array.from(section.querySelectorAll<HTMLElement>(".sp-panel"));
    const dots = Array.from(section.querySelectorAll<HTMLElement>(".sp-dot"));
    const markers = Array.from(section.querySelectorAll<HTMLElement>(".sp-marker"));
    let active = 0;

    const setActive = (n: number) => {
      if (n === active) return;
      active = n;
      panels.forEach((p, i) => p.classList.toggle("is-on", i === n));
      dots.forEach((d, i) => d.classList.toggle("is-on", i === n));
      window.dispatchEvent(
        new CustomEvent("deckchange", { detail: { id: markers[n]?.id } })
      );
    };

    // el marker que cruza el centro del viewport define el paso activo
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(Number((e.target as HTMLElement).dataset.step));
        });
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 }
    );
    markers.forEach((m) => io.observe(m));

    // click en un dot → scroll a ese tramo
    dots.forEach((d, i) => {
      d.addEventListener("click", () => {
        markers[i]?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });

    // entrada de una sola vía (una vez que entró, queda fija)
    const stage = section.querySelector<HTMLElement>(".sp-stage");
    if (stage) {
      const enterIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            section.classList.add("seen");
            window.dispatchEvent(
              new CustomEvent("deckchange", { detail: { id: markers[active]?.id } })
            );
          });
        },
        { threshold: 0.4 }
      );
      enterIo.observe(stage);
    }

    if (!reduce) {
      // textura del fondo en parallax (va por detrás)
      const fillInner = section.querySelector<HTMLElement>(".sp-fill-inner");
      if (fillInner) {
        scroll(animate(fillInner, { y: [-120, 120] }, { ease: "linear" }), {
          target: section,
          offset: ["start end", "end start"],
        });
      }
      // salida: el contenido queda rezagado y se apaga mientras entra la siguiente
      const inner = section.querySelector<HTMLElement>(".sp-inner");
      if (inner) {
        scroll(animate(inner, { y: [0, 150] }, { ease: "linear" }), {
          target: section,
          offset: ["end end", "end start"],
        });
        scroll(animate(inner, { opacity: [1, 0.35] }, { ease: "linear" }), {
          target: section,
          offset: ["end end", "end start"],
        });
      }
    }
  }
</script>

<style lang="scss">
  .sp {
    position: relative;
    /* 3 pasos × 160vh */
    height: 480vh;
    z-index: 31;
    /* se monta sobre la sección anterior (plano pleno, sin radius) */
    margin-top: clamp(-14vh, -10vh, -60px);
    box-shadow: 0 -26px 60px -22px rgba(0, 0, 0, 0.42);
  }

  /* fondo pleno fijo: lo que hace que las dos se lean como una misma sección */
  .sp-fill {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--section-fill, var(--section-bg));
  }
  /* dots de la sección: capa aparte, quietas (sin parallax ni deriva),
     igual que las del fondo de la página (en temas sin dots quedan invisibles) */
  .sp-fill-dots {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(26vw 26vw at 12% 18%, var(--dot-a, transparent), transparent 64%),
      radial-gradient(21vw 21vw at 84% 30%, var(--dot-b, transparent), transparent 64%),
      radial-gradient(24vw 24vw at 32% 88%, var(--dot-c, transparent), transparent 64%),
      radial-gradient(16vw 16vw at 68% 72%, var(--dot-b, transparent), transparent 64%);
  }

  .sp-fill-inner {
    position: absolute;
    top: -18%;
    left: 0;
    width: 100%;
    height: 136%;
    background:
      radial-gradient(
        80% 60% at 16% 14%,
        color-mix(in srgb, var(--accent) 13%, transparent),
        transparent 60%
      ),
      radial-gradient(
        70% 55% at 88% 86%,
        color-mix(in srgb, var(--fg) 7%, transparent),
        transparent 60%
      );
    will-change: transform;
  }

  .sp-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 0 var(--gutter);
    overflow: hidden;
  }
  .sp-markers {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .sp-marker {
    flex: 1;
    scroll-snap-align: center;
  }

  .sp-inner {
    width: min(1180px, 94vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(28px, 4.5vh, 52px);
  }

  /* indicador mínimo: 3 dots sin fondo */
  .sp-dots {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sp.seen .sp-dots { opacity: 1; transform: none; }
  .sp-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 100px;
    background: color-mix(in srgb, var(--fg) 24%, transparent);
    cursor: pointer;
    transition:
      width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.35s ease;

    &:hover { background: color-mix(in srgb, var(--fg) 40%, transparent); }
    /* el activo se estira: se lee el progreso sin necesidad de labels */
    &.is-on {
      width: 26px;
      background: var(--accent);
    }
  }

  /* paneles apilados: el activo se ve, los otros no */
  .sp-panels {
    display: grid;
    width: 100%;
  }
  .sp-panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) 1.35fr;
    gap: clamp(30px, 4.5vw, 68px);
    align-items: start;
    text-align: left;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.35s ease, visibility 0.35s;
  }
  .sp-panel.is-on { visibility: visible; opacity: 1; }

  /* animación por parte, al entrar la sección y al cambiar de paso */
  .sp-head,
  .sp-content {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sp.seen .sp-panel.is-on .sp-head { opacity: 1; transform: none; transition-delay: 0.1s; }
  .sp.seen .sp-panel.is-on .sp-content { opacity: 1; transform: none; transition-delay: 0.26s; }

  .sp-eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .sp-title {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.1vw, 42px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .sp-body {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(14px, 1.1vw, 16.5px);
    line-height: 1.65;
    color: var(--fg-muted);
  }
  /* el contenido ya está en su columna: sin margen superior propio */
  .sp-content > :global(*) { margin-top: 0; }

  @media only screen and (max-width: 1024px) {
    .sp { height: auto; margin-top: 0; }
    .sp-stage {
      position: static;
      height: auto;
      min-height: 100vh;
      padding: 80px var(--gutter);
    }
    .sp-markers { display: none; }
    /* en mobile los dos pasos se apilan */
    .sp-panels { display: flex; flex-direction: column; gap: 64px; }
    .sp-panel {
      grid-template-columns: 1fr;
      gap: 24px;
      visibility: visible;
      opacity: 1;
    }
    .sp-head, .sp-content { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-panel, .sp-head, .sp-content { transition: none; }
  }
</style>
