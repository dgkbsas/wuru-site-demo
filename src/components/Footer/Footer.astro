---
// Footer flotante minimalista: copyright + enlaces esenciales.
---

<footer class="site-footer" id="footer-container">
  <span class="copy">© 2026 Wúru</span>
  <nav class="foot-links">
    <a href="mailto:hola@wuru.ai" title="Email us">hola@wuru.ai</a>
    <a href="http://docs.wuru.ai" target="_blank" rel="noopener noreferrer" title="Wúru Docs">Docs</a>
    <a href="/privacy-policy" title="Privacy policy">Privacy</a>
  </nav>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--gutter);
    font-size: 12px;
    letter-spacing: 0.5px;
    color: var(--fg-muted);
    pointer-events: none; /* no bloquea el contenido; sólo los enlaces son clickeables */
  }
  .site-footer .copy {
    pointer-events: auto;
  }
  .foot-links {
    display: flex;
    gap: 24px;
    pointer-events: auto;
  }
  .foot-links a {
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .foot-links a:hover {
    color: var(--fg);
  }

  @media only screen and (max-width: 640px) {
    .site-footer {
      padding: 12px 20px;
      font-size: 11px;
    }
    .foot-links {
      gap: 16px;
    }
  }
</style>
