---
import Layout from "../layouts/Base.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import SectionNav from "../components/SectionNav.astro";
import Header from "../components/Header/Header.astro";
import Hero from "../components/Hero/Hero.astro";
import DeckSection from "../components/DeckSection.astro";
import Clients from "../components/Clients.astro";
import WuruLayers from "../components/WuruLayers.astro";
import LiveStatus from "../components/LiveStatus.astro";
import PlatformPinned from "../components/PlatformPinned.astro";
import SolutionsPinned from "../components/SolutionsPinned.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer/Footer.astro";

const wuruTitle =
  `<span class='t-the'>The</span>` +
  `<span class='t-hero hl'>Intelligence Layer</span>` +
  `<span class='t-sub'>for every healthcare operation</span>`;

---

<Layout title="Wúru">
  <ThemeSwitcher />
  <SectionNav />
  <Header />

  <Hero />

  <DeckSection
    id="wuru"
    center
    dwell={1.2}
    title={wuruTitle}
    paragraphs={["Every interaction expands what your teams can delegate — <strong>people stay at the center</strong>."]}
  >
    <WuruLayers slot="bg" />
    <div class="wuru-live">
      <LiveStatus />
    </div>
  </DeckSection>

  <PlatformPinned />

  <!-- Solutions y Security viven en un solo bloque pineado: el fondo y el
       switcher quedan fijos y el contenido pasa de una a la otra -->
  <SolutionsPinned />

  <!-- cierre unificado: CTA + clientes + partnerships -->
  <section class="closing snap-section">
    <div class="closing-in">
      <FinalCta />
      <Clients />
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* card "WÚRU OS · LIVE" dentro del statement de WÚRU: centrada, entra al final */
  .wuru-live {
    margin: 44px auto 0;
    width: max-content;
    max-width: 100%;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0.58s;
  }
  :global(.deck-section.is-active) .wuru-live {
    opacity: 1;
    transform: none;
  }
  @media only screen and (max-width: 1024px) {
    .wuru-live {
      opacity: 1;
      transform: none;
    }
    /* sin monte negativo en flujo normal */
    .closing {
      margin-top: 0;
      box-shadow: none;
      padding: clamp(56px, 12vw, 96px) var(--gutter);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wuru-live {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* el cierre también se monta sobre la sección anterior: plano propio (un poco
     más profundo que el de la sección de arriba) + sombra hacia arriba */
  .closing {
    position: relative;
    z-index: 32;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(64px, 10vw, 120px) var(--gutter);
    margin-top: clamp(-8vh, -5vh, -40px);
    background: var(--section-fill, color-mix(in srgb, var(--section-bg) 92%, var(--fg)));
    box-shadow: 0 -26px 60px -22px rgba(0, 0, 0, 0.42);
  }
  .closing-in {
    width: 100%;
    max-width: 1040px;
  }
  /* separación entre el CTA y la prueba social (clientes + partnerships) */
  .closing :global(.clients) {
    margin-top: clamp(34px, 5vh, 60px);
    padding-top: clamp(28px, 4vh, 44px);
    border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
  }
  .closing :global(.clients-marquee) {
    margin-inline: auto;
  }
  .closing :global(.clients-row) {
    justify-content: center;
  }
</style>

<script>
  // Sincronía del picker + deblur de secciones con el scroll
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        // se observa el stage (100vh), así que el id lo da la sección contenedora
        const host = (e.target as HTMLElement).closest<HTMLElement>(".hero, .deck-section");
        const id = host?.classList.contains("hero") ? "inicio" : host?.id;
        if (id) window.dispatchEvent(new CustomEvent("deckchange", { detail: { id } }));
      });
    },
    { threshold: 0.5 }
  );
  // Se observa el .ds-stage cuando existe: una sección con dwell mide más de
  // 100vh, y con threshold 0.5 sobre la sección nunca llegaría a activarse.
  // Los bloques pineados (#plataforma, #solutions-security) despachan su propio
  // deckchange internamente.
  document.querySelectorAll<HTMLElement>(".hero, #wuru").forEach((el) => {
    io.observe(el.querySelector<HTMLElement>(".ds-stage") ?? el);
  });

  // Deblur → nítido del contenido de la sección activa.
  // Entrada de UNA SOLA VÍA: una vez que la sección entró y animó, queda fija.
  // Ninguna sección anima la salida.
  const deckSections = document.querySelectorAll<HTMLElement>(".deck-section");
  window.addEventListener("deckchange", (e) => {
    const id = (e as CustomEvent).detail?.id;
    deckSections.forEach((s) => {
      if (s.id === id) s.classList.add("is-active");
    });
  });

  // Click en el picker → scroll suave a la sección
  window.addEventListener("decknav", (e) => {
    const id = (e as CustomEvent).detail?.id;
    if (id === "inicio") {
      window.scrollTo({ top: 0, behavior: "smooth" });
    } else {
      document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
    }
  });
</script>
